APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=realestate
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use `sync` if you are not running `php artisan queue:work` (jobs run immediately in the web request).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev: log driver. Production (cPanel): use smtp + port 465 (SSL is auto via smtps when PORT=465).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Production: Lele Sasto Ghar / cPanel email (SMTP) ---
# Outgoing: mail.lelesastogharjagga.com.np:465 (SSL). Use this mailbox’s cPanel password in MAIL_PASSWORD only in .env (never commit).
# MAIL_MAILER=smtp
# MAIL_HOST=mail.lelesastogharjagga.com.np
# MAIL_PORT=465
# MAIL_SCHEME=null
# MAIL_USERNAME=account@lelesastogharjagga.com.np
# MAIL_PASSWORD=your_cpanel_email_password_here
# MAIL_FROM_ADDRESS="account@lelesastogharjagga.com.np"
# MAIL_FROM_NAME="${APP_NAME}"
# Optional if the server is picky about EHLO: MAIL_EHLO_DOMAIN=lelesastogharjagga.com.np

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Twilio SMS (optional; Messaging Service SID recommended) ---
# TWILIO_ENABLED=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# # Or use a single sender number instead of Messaging Service:
# # TWILIO_FROM=+1xxxxxxxxxx
# # For local numbers without +country (e.g. Nepal mobile): default country code prepended
# TWILIO_DEFAULT_COUNTRY_CODE=977
# Comma-separated E.164 or local numbers — SMS when someone uses /contact
# TWILIO_CONTACT_NOTIFY_NUMBERS=
# Extra numbers (besides the listing agent’s phone) for property listing inquiries
# TWILIO_INQUIRY_NOTIFY_NUMBERS=

# --- Dashboard / support links (optional) ---
# WhatsApp for wa.me (digits only, with country code, no +)
# SUPPORT_WHATSAPP_DIGITS=9779765726294
# SUPPORT_MESSENGER_URL=https://m.me/yourpage
